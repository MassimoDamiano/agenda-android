<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/tvDetailName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />
    <TextView android:id="@+id/tvDetailPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
    <TextView android:id="@+id/tvDetailAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/edit" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/delete" />
</LinearLayout>
